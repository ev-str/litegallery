{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "skipLibCheck": true
  },
  "include": [
    "web/app-surfaces.js",
    "web/collage-landing.js",
    "web/collage/**/*.js",
    "web/live-refresh.js",
    "web/load-queue.js",
    "web/media-window.js",
    "web/slideshow.js"
  ]
}
